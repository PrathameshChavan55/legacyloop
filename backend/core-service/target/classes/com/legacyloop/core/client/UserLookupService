package com.legacyloop.core.client;

import com.legacyloop.common.constant.CacheConstants;
import com.legacyloop.common.dto.UserSummaryDto;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.cache.annotation.Cacheable;
import org.springframework.stereotype.Service;

import java.util.Collection;
import java.util.List;
import java.util.Map;
import java.util.function.Function;
import java.util.stream.Collectors;

/**
 * Thin wrapper so the rest of core-service never touches Feign directly, and so the Redis
 * cache lives in exactly one place.
 */
@Slf4j
@Service
@RequiredArgsConstructor
public class UserLookupService {

    private final AuthServiceClient authServiceClient;

    @Cacheable(value = CacheConstants.USER_SUMMARY, key = "#userId", unless = "#result == null")
    public UserSummaryDto getUser(Long userId) {
        if (userId == null) {
            return null;
        }
        return authServiceClient.getUser(userId).data();
    }

    /**
     * One HTTP call for a whole page. Calling getUser() in a loop would be the N+1 problem
     * moved from the database to the network - which is worse, not better.
     */
    public Map<Long, UserSummaryDto> getUsers(Collection<Long> userIds) {
        if (userIds == null || userIds.isEmpty()) {
            return Map.of();
        }
        List<Long> distinct = userIds.stream().filter(java.util.Objects::nonNull).distinct().toList();
        List<UserSummaryDto> summaries = authServiceClient
                .getUsers(Map.of("userIds", distinct))
                .data();

        if (summaries == null) {
            return Map.of();
        }
        return summaries.stream()
                .collect(Collectors.toMap(UserSummaryDto::userId, Function.identity(), (a, b) -> a));
    }
}
