package com.legacyloop.core.controller;

import com.legacyloop.common.dto.ApiResponse;
import com.legacyloop.common.dto.PageResponse;
import com.legacyloop.core.dto.request.CreateJobRequest;
import com.legacyloop.core.dto.request.UpdateJobRequest;
import com.legacyloop.core.dto.response.JobResponse;
import com.legacyloop.core.service.JobService;
import io.swagger.v3.oas.annotations.Operation;
import io.swagger.v3.oas.annotations.tags.Tag;
import jakarta.validation.Valid;
import lombok.RequiredArgsConstructor;
import org.springframework.data.domain.Pageable;
import org.springframework.data.domain.Sort;
import org.springframework.data.web.PageableDefault;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.security.access.prepost.PreAuthorize;
import org.springframework.web.bind.annotation.*;

import java.math.BigDecimal;

@RestController
@RequestMapping("/api/v1/jobs")
@RequiredArgsConstructor
@Tag(name = "Jobs", description = "Posting, searching and managing job listings")
public class JobController {

    private final JobService jobService;

    @PostMapping
    @Operation(summary = "Post a job", description = "Alumni and placement heads only (SRS REQ-4.1)")
    @PreAuthorize("hasAnyRole('ALUMNI','INSTITUTION_STAFF','PLATFORM_ADMIN')")
    public ResponseEntity<ApiResponse<JobResponse>> create(@Valid @RequestBody CreateJobRequest request) {
        return ResponseEntity.status(HttpStatus.CREATED)
                .body(ApiResponse.success(jobService.create(request), "Job posted"));
    }

    @GetMapping
    @Operation(summary = "Search jobs",
            description = "Filter by keyword, skill tags, location, type, company or salary (SRS REQ-3.2)")
    public ResponseEntity<ApiResponse<PageResponse<JobResponse>>> search(
            @RequestParam(required = false) String keyword,
            @RequestParam(required = false) String skills,
            @RequestParam(required = false) String location,
            @RequestParam(required = false) String employmentType,
            @RequestParam(required = false) Long companyId,
            @RequestParam(required = false) BigDecimal minSalary,
            @RequestParam(required = false) String status,
            @PageableDefault(size = 10, sort = "createdAt", direction = Sort.Direction.DESC)
            Pageable pageable) {
        return ResponseEntity.ok(ApiResponse.success(jobService.search(keyword, skills, location,
                employmentType, companyId, minSalary, status, pageable)));
    }

    @GetMapping("/{jobId}")
    @Operation(summary = "Job detail")
    public ResponseEntity<ApiResponse<JobResponse>> byId(@PathVariable Long jobId) {
        return ResponseEntity.ok(ApiResponse.success(jobService.getById(jobId)));
    }

    @GetMapping("/mine")
    @Operation(summary = "Jobs you posted")
    @PreAuthorize("hasAnyRole('ALUMNI','INSTITUTION_STAFF','PLATFORM_ADMIN')")
    public ResponseEntity<ApiResponse<PageResponse<JobResponse>>> mine(
            @PageableDefault(size = 10) Pageable pageable) {
        return ResponseEntity.ok(ApiResponse.success(jobService.myPostings(pageable)));
    }

    @PutMapping("/{jobId}")
    @Operation(summary = "Update a job you posted")
    @PreAuthorize("hasAnyRole('ALUMNI','INSTITUTION_STAFF','PLATFORM_ADMIN')")
    public ResponseEntity<ApiResponse<JobResponse>> update(@PathVariable Long jobId,
                                                           @Valid @RequestBody UpdateJobRequest request) {
        return ResponseEntity.ok(ApiResponse.success(jobService.update(jobId, request), "Job updated"));
    }

    @DeleteMapping("/{jobId}")
    @Operation(summary = "Close a job", description = "Soft close - the listing and its applications remain")
    @PreAuthorize("hasAnyRole('ALUMNI','INSTITUTION_STAFF','PLATFORM_ADMIN')")
    public ResponseEntity<ApiResponse<Void>> close(@PathVariable Long jobId) {
        jobService.close(jobId);
        return ResponseEntity.ok(ApiResponse.message("Job closed"));
    }
}
