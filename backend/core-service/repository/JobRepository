package com.legacyloop.core.repository;

import com.legacyloop.common.enums.JobStatus;
import com.legacyloop.core.entity.Job;
import org.springframework.data.domain.Page;
import org.springframework.data.domain.Pageable;
import org.springframework.data.jpa.repository.EntityGraph;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.JpaSpecificationExecutor;
import org.springframework.data.jpa.repository.Modifying;
import org.springframework.data.jpa.repository.Query;
import org.springframework.data.repository.query.Param;
import org.springframework.stereotype.Repository;

import java.time.LocalDate;
import java.util.Optional;

@Repository
public interface JobRepository extends JpaRepository<Job, Long>, JpaSpecificationExecutor<Job> {

    /** Company is fetched with the job so a page of 20 jobs is 1 query, not 21. */
    @Override
    @EntityGraph(attributePaths = "company")
    Page<Job> findAll(org.springframework.data.jpa.domain.Specification<Job> spec, Pageable pageable);

    @EntityGraph(attributePaths = "company")
    Optional<Job> findWithCompanyById(Long id);

    @EntityGraph(attributePaths = "company")
    Page<Job> findByPostedByUserId(Long postedByUserId, Pageable pageable);

    @Modifying
    @Query("update Job j set j.applicationCount = j.applicationCount + 1 where j.id = :jobId")
    void incrementApplicationCount(@Param("jobId") Long jobId);

    @Modifying
    @Query("""
            update Job j set j.status = :expired
            where j.status = :open and j.applicationDeadline is not null and j.applicationDeadline < :today
            """)
    int expireOverdueJobs(@Param("open") JobStatus open,
                          @Param("expired") JobStatus expired,
                          @Param("today") LocalDate today);

    long countByStatus(JobStatus status);
}
