package com.legacyloop.core.service.impl;

import com.legacyloop.common.dto.PageResponse;
import com.legacyloop.common.enums.Role;
import com.legacyloop.common.event.UserRegisteredEvent;
import com.legacyloop.common.exception.ResourceNotFoundException;
import com.legacyloop.common.security.SecurityContextUtil;
import com.legacyloop.core.dto.request.UpdateAlumniProfileRequest;
import com.legacyloop.core.dto.request.UpdateStudentProfileRequest;
import com.legacyloop.core.dto.response.AlumniProfileResponse;
import com.legacyloop.core.dto.response.StudentProfileResponse;
import com.legacyloop.core.entity.AlumniProfile;
import com.legacyloop.core.entity.StudentProfile;
import com.legacyloop.core.mapper.CoreMapper;
import com.legacyloop.core.repository.AlumniProfileRepository;
import com.legacyloop.core.repository.StudentProfileRepository;
import com.legacyloop.core.service.ProfileService;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.data.domain.Page;
import org.springframework.data.domain.Pageable;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;
import org.springframework.util.StringUtils;

@Slf4j
@Service
@RequiredArgsConstructor
public class ProfileServiceImpl implements ProfileService {

    private final StudentProfileRepository studentRepository;
    private final AlumniProfileRepository alumniRepository;
    private final CoreMapper mapper;

    /**
     * Driven by the user.registered event, so core-service never reaches into the auth
     * database. Idempotent because the event may be redelivered.
     */
    @Override
    @Transactional
    public void createFromRegistration(UserRegisteredEvent event) {
        Role role = Role.from(event.role());
        if (role == Role.ROLE_STUDENT) {
            if (studentRepository.existsByUserId(event.userId())) {
                return;
            }
            studentRepository.save(StudentProfile.builder()
                    .userId(event.userId())
                    .fullName(event.fullName())
                    .prn(event.prn())
                    .batchId(event.batchId())
                    .profileComplete(false)
                    .build());
            log.info("Created student profile for user {}", event.userId());

        } else if (role == Role.ROLE_ALUMNI) {
            if (alumniRepository.existsByUserId(event.userId())) {
                return;
            }
            alumniRepository.save(AlumniProfile.builder()
                    .userId(event.userId())
                    .fullName(event.fullName())
                    .graduationYear(event.graduationYear())
                    .companyName(event.companyName())
                    .mentorshipAvailable(false)
                    .build());
            log.info("Created alumni profile for user {}", event.userId());
        }
    }

    @Override
    @Transactional(readOnly = true)
    public StudentProfileResponse myStudentProfile() {
        return mapper.toResponse(loadStudent());
    }

    @Override
    @Transactional
    public StudentProfileResponse updateStudentProfile(UpdateStudentProfileRequest request) {
        StudentProfile profile = loadStudent();

        if (request.skills() != null) {
            profile.setSkills(request.skills());
        }
        if (request.githubUrl() != null) {
            profile.setGithubUrl(request.githubUrl());
        }
        if (request.linkedinUrl() != null) {
            profile.setLinkedinUrl(request.linkedinUrl());
        }
        if (request.education() != null) {
            profile.setEducation(request.education());
        }
        if (request.projects() != null) {
            profile.setProjects(request.projects());
        }

        // "Complete" gates nothing yet, but it drives the dashboard progress bar.
        profile.setProfileComplete(StringUtils.hasText(profile.getSkills())
                && StringUtils.hasText(profile.getEducation())
                && profile.getPrimaryResumeId() != null);

        return mapper.toResponse(studentRepository.save(profile));
    }

    @Override
    @Transactional(readOnly = true)
    public AlumniProfileResponse myAlumniProfile() {
        return mapper.toResponse(loadAlumni());
    }

    @Override
    @Transactional
    public AlumniProfileResponse updateAlumniProfile(UpdateAlumniProfileRequest request) {
        AlumniProfile profile = loadAlumni();

        if (request.expertise() != null) {
            profile.setExpertise(request.expertise());
        }
        if (request.mentorshipAvailable() != null) {
            profile.setMentorshipAvailable(request.mentorshipAvailable());
        }
        if (request.linkedinUrl() != null) {
            profile.setLinkedinUrl(request.linkedinUrl());
        }
        if (request.companyName() != null) {
            profile.setCompanyName(request.companyName());
        }
        if (request.designation() != null) {
            profile.setDesignation(request.designation());
        }
        return mapper.toResponse(alumniRepository.save(profile));
    }

    @Override
    @Transactional(readOnly = true)
    public PageResponse<AlumniProfileResponse> mentors(Pageable pageable) {
        Page<AlumniProfile> page = alumniRepository.findByMentorshipAvailableTrue(pageable);
        return PageResponse.of(page.getContent().stream().map(mapper::toResponse).toList(),
                page.getNumber(), page.getSize(), page.getTotalElements());
    }

    private StudentProfile loadStudent() {
        Long userId = SecurityContextUtil.requireUserId();
        return studentRepository.findByUserId(userId)
                .orElseThrow(() -> new ResourceNotFoundException("Student profile", "userId", userId));
    }

    private AlumniProfile loadAlumni() {
        Long userId = SecurityContextUtil.requireUserId();
        return alumniRepository.findByUserId(userId)
                .orElseThrow(() -> new ResourceNotFoundException("Alumni profile", "userId", userId));
    }
}
