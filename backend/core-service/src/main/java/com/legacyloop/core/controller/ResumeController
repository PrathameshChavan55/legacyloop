package com.legacyloop.core.controller;

import com.legacyloop.common.dto.ApiResponse;
import com.legacyloop.core.dto.response.ResumeResponse;
import com.legacyloop.core.service.ResumeService;
import com.legacyloop.core.service.impl.S3StorageService;
import io.swagger.v3.oas.annotations.Operation;
import io.swagger.v3.oas.annotations.tags.Tag;
import lombok.RequiredArgsConstructor;
import org.springframework.core.io.FileSystemResource;
import org.springframework.core.io.Resource;
import org.springframework.http.HttpHeaders;
import org.springframework.http.HttpStatus;
import org.springframework.http.MediaType;
import org.springframework.http.ResponseEntity;
import org.springframework.security.access.prepost.PreAuthorize;
import org.springframework.web.bind.annotation.*;
import org.springframework.web.multipart.MultipartFile;

import java.util.List;

@RestController
@RequestMapping("/api/v1/resumes")
@RequiredArgsConstructor
@Tag(name = "Resumes", description = "Upload, list and manage PDF resumes (SRS REQ-3.1)")
public class ResumeController {

    private final ResumeService resumeService;
    private final S3StorageService storageService;

    @PostMapping(consumes = MediaType.MULTIPART_FORM_DATA_VALUE)
    @Operation(summary = "Upload a PDF resume",
            description = "Text is extracted at upload with PDFBox/Tika so the AI worker never re-reads the file")
    @PreAuthorize("hasRole('STUDENT')")
    public ResponseEntity<ApiResponse<ResumeResponse>> upload(
            @RequestParam("file") MultipartFile file,
            @RequestParam(defaultValue = "false") boolean makePrimary) {
        return ResponseEntity.status(HttpStatus.CREATED)
                .body(ApiResponse.success(resumeService.upload(file, makePrimary), "Resume uploaded"));
    }

    @GetMapping("/mine")
    @Operation(summary = "Your resumes")
    public ResponseEntity<ApiResponse<List<ResumeResponse>>> mine() {
        return ResponseEntity.ok(ApiResponse.success(resumeService.myResumes()));
    }

    @PatchMapping("/{resumeId}/primary")
    @Operation(summary = "Make a resume the default for applications")
    public ResponseEntity<ApiResponse<ResumeResponse>> setPrimary(@PathVariable Long resumeId) {
        return ResponseEntity.ok(ApiResponse.success(resumeService.setPrimary(resumeId),
                "Primary resume updated"));
    }

    @DeleteMapping("/{resumeId}")
    @Operation(summary = "Delete a resume")
    public ResponseEntity<ApiResponse<Void>> delete(@PathVariable Long resumeId) {
        resumeService.delete(resumeId);
        return ResponseEntity.ok(ApiResponse.message("Resume deleted"));
    }

    /**
     * Local-storage mode only. In S3 mode the client uses the presigned URL instead, so this
     * endpoint never runs.
     */
    @GetMapping("/local/**")
    @Operation(summary = "Download (local storage mode only)")
    public ResponseEntity<Resource> downloadLocal(jakarta.servlet.http.HttpServletRequest request) {
        if (!storageService.isLocal()) {
            return ResponseEntity.notFound().build();
        }
        String key = request.getRequestURI().split("/api/v1/resumes/local/")[1];
        FileSystemResource resource = new FileSystemResource(storageService.localPath(key));
        if (!resource.exists()) {
            return ResponseEntity.notFound().build();
        }
        return ResponseEntity.ok()
                .contentType(MediaType.APPLICATION_PDF)
                .header(HttpHeaders.CONTENT_DISPOSITION, "inline; filename=\"" + resource.getFilename() + "\"")
                .body(resource);
    }
}
