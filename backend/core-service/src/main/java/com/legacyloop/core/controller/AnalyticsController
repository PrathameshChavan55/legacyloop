package com.legacyloop.core.controller;

import com.legacyloop.common.dto.ApiResponse;
import com.legacyloop.core.dto.response.PlacementStatsResponse;
import com.legacyloop.core.service.AnalyticsService;
import io.swagger.v3.oas.annotations.Operation;
import io.swagger.v3.oas.annotations.tags.Tag;
import lombok.RequiredArgsConstructor;
import org.springframework.http.HttpHeaders;
import org.springframework.http.MediaType;
import org.springframework.http.ResponseEntity;
import org.springframework.security.access.prepost.PreAuthorize;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

@RestController
@RequestMapping("/api/v1/analytics")
@RequiredArgsConstructor
@PreAuthorize("hasAnyRole('INSTITUTION_STAFF','PLATFORM_ADMIN')")
@Tag(name = "Analytics", description = "Placement dashboards and exports (SRS REQ-5.2 / REQ-5.3)")
public class AnalyticsController {

    private final AnalyticsService analyticsService;

    @GetMapping("/placement-stats")
    @Operation(summary = "Aggregate placement metrics")
    public ResponseEntity<ApiResponse<PlacementStatsResponse>> stats() {
        return ResponseEntity.ok(ApiResponse.success(analyticsService.placementStats()));
    }

    @GetMapping("/applications/export")
    @Operation(summary = "Export every application as CSV")
    public ResponseEntity<byte[]> exportCsv() {
        byte[] csv = analyticsService.exportApplicationsCsv();
        return ResponseEntity.ok()
                .contentType(MediaType.parseMediaType("text/csv"))
                .header(HttpHeaders.CONTENT_DISPOSITION, "attachment; filename=\"applications.csv\"")
                .body(csv);
    }
}
