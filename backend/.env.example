# =============================================================================
# LegacyLoop - copy to .env and fill in. .env is gitignored; NEVER commit it.
#   cp .env.example .env
# =============================================================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_USER=legacyloop
MYSQL_PASSWORD=change_me_app
MYSQL_HOST=ll-mysql
MYSQL_PORT=3306
MYSQL_EXTERNAL_PORT=3307
AUTH_DB_NAME=legacyloop_auth
CORE_DB_NAME=legacyloop_core
PAYMENT_DB_NAME=legacyloop_payment

# ---------- MongoDB ----------
MONGO_HOST=ll-mongodb
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=change_me_mongo
MONGO_DB_NAME=legacyloop_feed
MONGO_APP_USER=legacyloop
MONGO_APP_PASSWORD=change_me_mongo_app

# ---------- Redis ----------
REDIS_HOST=ll-redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis

# ---------- RabbitMQ ----------
RABBITMQ_HOST=ll-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=legacyloop
RABBITMQ_PASSWORD=change_me_rabbit
RABBITMQ_VHOST=/

# ---------- JWT ----------
# Generate with: openssl rand -base64 64
JWT_SECRET=replace_with_a_64_byte_base64_secret
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
JWT_ISSUER=legacyloop

# Shared secret for /internal/** calls between services
INTERNAL_API_KEY=replace_with_a_random_uuid

# ---------- institution (first-run defaults; editable in the UI afterwards) ----------
# Leave INSTITUTION_NAME blank and the platform shows "Your Institution" until configured.
INSTITUTION_CODE=default
INSTITUTION_NAME=
INSTITUTION_SHORT_NAME=
INSTITUTION_LOGO_URL=
INSTITUTION_ADDRESS=
INSTITUTION_EMAIL=
INSTITUTION_PHONE=
INSTITUTION_WEBSITE=
INSTITUTION_THEME_COLOR=#1F3BB3
INSTITUTION_ACADEMIC_YEAR=

# What your institution calls its student identifier, and the format it must match.
# Examples: Roll Number ^\d{8}$ | Enrollment Number ^[A-Z]{2}\d{6}$ | PRN ^\d{12}$
STUDENT_IDENTIFIER_LABEL=Student ID
STUDENT_IDENTIFIER_REGEX=^[A-Za-z0-9/-]{4,32}$
STUDENT_IDENTIFIER_HINT=4-32 letters, digits, hyphen or slash

# What your institution calls the staff role.
# Examples: Placement Head | Career Officer | Training Coordinator | Student Success Lead
STAFF_ROLE_LABEL=Institution Staff

# ---------- first administrator ----------
# Created on auth-service startup if it does not exist. Leave blank to skip.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=Admin@LegacyLoop1
ADMIN_FULL_NAME=Platform Admin

# ---------- mail ----------
# false = OTPs are logged to the console instead of emailed (use this in development)
MAIL_ENABLED=false

# ---------- service discovery / config ----------
EUREKA_URL=http://ll-eureka-server:8761/eureka/
CONFIG_SERVER_URL=http://ll-config-server:8888
SPRING_PROFILES_ACTIVE=dev

# ---------- AWS S3 ----------
AWS_REGION=ap-south-1
AWS_S3_BUCKET=legacyloop-media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PRESIGN_MINUTES=15

# ---------- AI ----------
AI_PROVIDER=GEMINI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3

# ---------- Razorpay ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

# ---------- mail (Gmail app password or Mailtrap in dev) ----------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.org

# =============================================================================
# ---------- AWS Managed Services (used when SPRING_PROFILES_ACTIVE=aws) ------
# =============================================================================
# Switch from Docker containers to AWS managed services by setting:
#   SPRING_PROFILES_ACTIVE=aws
# Then fill in the endpoints below. Leave blank if using Docker (dev/prod profile).
# Use docker-compose.aws.yml instead of docker-compose.yml on EC2.

# ---------- Amazon Aurora MySQL (replaces MySQL Docker) ----------
# Use the WRITER (cluster) endpoint, not an instance endpoint.
# Format: <cluster-name>.cluster-<id>.<region>.rds.amazonaws.com
AURORA_HOST=
AURORA_PORT=3306
# NOTE: MYSQL_USER and MYSQL_PASSWORD (above) are reused for Aurora.

# ---------- Amazon DocumentDB (replaces MongoDB Docker) ----------
# Format: <cluster-name>.cluster-<id>.<region>.docdb.amazonaws.com
# IMPORTANT: DocumentDB always uses TLS. You MUST also provide the CA bundle.
# Download:  curl -o ./config/global-bundle.pem \
#              https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
# Then convert to JKS (one time):
#   keytool -import -alias docdb -file ./config/global-bundle.pem \
#     -keystore ./config/global-bundle.jks -storepass changeit -noprompt
DOCDB_HOST=
DOCDB_PORT=27017
# NOTE: MONGO_APP_USER and MONGO_APP_PASSWORD (above) are reused for DocumentDB.

# ---------- Amazon ElastiCache for Redis (replaces Redis Docker) ----------
# Format: <cluster>.cache.amazonaws.com
# In-transit encryption must be enabled on the ElastiCache cluster.
# The AUTH token below maps to spring.data.redis.password.
ELASTICACHE_HOST=
ELASTICACHE_PORT=6379
ELASTICACHE_AUTH_TOKEN=

# ---------- Amazon MQ — RabbitMQ engine (replaces RabbitMQ Docker) ----------
# Format: b-<id>.mq.<region>.amazonaws.com  (no amqps:// prefix)
# Port 5671 = AMQPS (TLS) — Amazon MQ does NOT allow plain AMQP on 5672.
AMAZONMQ_HOST=
AMAZONMQ_PORT=5671
# NOTE: RABBITMQ_USER and RABBITMQ_PASSWORD (above) are reused for Amazon MQ.

# ---------- AWS Secrets Manager (optional — advanced) ----------
# If you store secrets in Secrets Manager instead of this .env file, set:
#   AWS_SECRETS_MANAGER_SECRET_NAME=legacyloop/prod/secrets
# and add the spring-cloud-starter-aws-secrets-manager dependency.
# The AWS SDK auto-discovers the IAM role on EC2 — no access key needed.
AWS_SECRETS_MANAGER_SECRET_NAME=

# =============================================================================
# ---------- frontend ----------
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_WS_URL=http://localhost:8080/ws
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# ---------- observability ----------
ZIPKIN_URL=http://ll-zipkin:9411/api/v2/spans
TRACING_SAMPLE_RATE=1.0
