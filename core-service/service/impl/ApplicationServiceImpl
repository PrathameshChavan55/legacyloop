package com.legacyloop.core.service.impl;

import com.legacyloop.common.dto.PageResponse;
import com.legacyloop.common.dto.UserSummaryDto;
import com.legacyloop.common.enums.ApplicationStatus;
import com.legacyloop.common.enums.Role;
import com.legacyloop.common.exception.BusinessException;
import com.legacyloop.common.exception.ConflictException;
import com.legacyloop.common.exception.ErrorCode;
import com.legacyloop.common.exception.ForbiddenException;
import com.legacyloop.common.exception.ResourceNotFoundException;
import com.legacyloop.common.security.AuthenticatedUser;
import com.legacyloop.common.security.SecurityContextUtil;
import com.legacyloop.core.client.UserLookupService;
import com.legacyloop.core.dto.request.ApplyRequest;
import com.legacyloop.core.dto.request.GrantReferralRequest;
import com.legacyloop.core.dto.request.UpdateApplicationStatusRequest;
import com.legacyloop.core.dto.response.ApplicationResponse;
import com.legacyloop.core.dto.response.ReferralResponse;
import com.legacyloop.core.entity.*;
import com.legacyloop.core.mapper.CoreMapper;
import com.legacyloop.core.publisher.CoreEventPublisher;
import com.legacyloop.core.repository.*;
import com.legacyloop.core.service.ApplicationService;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.data.domain.Page;
import org.springframework.data.domain.Pageable;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.time.Instant;
import java.util.List;
import java.util.Map;

/**
 * SRS REQ-3.3: applying publishes an event; the AI evaluation happens off the request thread.
 */
@Slf4j
@Service
@RequiredArgsConstructor
public class ApplicationServiceImpl implements ApplicationService {

    private final ApplicationRepository applicationRepository;
    private final JobRepository jobRepository;
    private final ResumeMetadataRepository resumeRepository;
    private final ReferralRepository referralRepository;
    private final UserLookupService userLookupService;
    private final CoreEventPublisher eventPublisher;
    private final CoreMapper mapper;

    @Override
    @Transactional
    public ApplicationResponse apply(Long jobId, ApplyRequest request) {
        AuthenticatedUser user = SecurityContextUtil.requireUser();
        if (!user.hasRole(Role.ROLE_STUDENT)) {
            throw new ForbiddenException(ErrorCode.ACCESS_DENIED, "Only students can apply to jobs");
        }

        Job job = jobRepository.findWithCompanyById(jobId)
                .orElseThrow(() -> new ResourceNotFoundException("Job", "id", jobId));

        if (!job.isOpen()) {
            throw new ConflictException(ErrorCode.JOB_CLOSED);
        }
        if (applicationRepository.existsByJobIdAndStudentUserId(jobId, user.userId())) {
            throw new ConflictException(ErrorCode.ALREADY_APPLIED);
        }

        ResumeMetadata resume = resolveResume(request.resumeId(), user.userId());

        Application application = Application.builder()
                .job(job)
                .studentUserId(user.userId())
                .resume(resume)
                .status(ApplicationStatus.APPLIED)
                .coverNote(request.coverNote())
                .appliedAt(Instant.now())
                .build();

        Application saved = applicationRepository.save(application);
        jobRepository.incrementApplicationCount(jobId);

        // Fire-and-forget: the ATS score arrives asynchronously (SRS REQ-3.3).
        eventPublisher.publishApplicationSubmitted(saved, resume);
        log.info("Student {} applied to job {} (application {})", user.userId(), jobId, saved.getId());

        return mapper.toResponse(saved);
    }

    private ResumeMetadata resolveResume(Long resumeId, Long userId) {
        if (resumeId != null) {
            ResumeMetadata resume = resumeRepository.findById(resumeId)
                    .orElseThrow(() -> new ResourceNotFoundException("Resume", "id", resumeId));
            if (!resume.getUserId().equals(userId)) {
                throw new ForbiddenException(ErrorCode.NOT_RESOURCE_OWNER,
                        "That resume belongs to someone else");
            }
            return resume;
        }
        return resumeRepository.findByUserIdAndPrimaryResumeTrue(userId)
                .orElseThrow(() -> new BusinessException(ErrorCode.RESUME_REQUIRED));
    }

    @Override
    @Transactional(readOnly = true)
    public ApplicationResponse getById(Long applicationId) {
        Application application = applicationRepository.findDetailedById(applicationId)
                .orElseThrow(() -> new ResourceNotFoundException("Application", "id", applicationId));
        assertCanView(application);

        ApplicationResponse response = mapper.toResponse(application);
        return response.withStudent(userLookupService.getUser(application.getStudentUserId()));
    }

    @Override
    @Transactional(readOnly = true)
    public PageResponse<ApplicationResponse> myApplications(Pageable pageable) {
        Long userId = SecurityContextUtil.requireUserId();
        Page<Application> page = applicationRepository
                .findByStudentUserIdOrderByAppliedAtDesc(userId, pageable);
        return PageResponse.of(page.getContent().stream().map(mapper::toResponse).toList(),
                page.getNumber(), page.getSize(), page.getTotalElements());
    }

    @Override
    @Transactional(readOnly = true)
    public PageResponse<ApplicationResponse> forJob(Long jobId, Pageable pageable) {
        Job job = jobRepository.findById(jobId)
                .orElseThrow(() -> new ResourceNotFoundException("Job", "id", jobId));
        assertCanManageJob(job);

        Page<Application> page = applicationRepository.findByJobIdOrderByAppliedAtDesc(jobId, pageable);
        List<ApplicationResponse> responses = page.getContent().stream()
                .map(mapper::toResponse)
                .toList();

        // SRS REQ-4.2: the alumni sees candidate profiles and ATS scores together.
        Map<Long, UserSummaryDto> students = userLookupService.getUsers(
                responses.stream().map(ApplicationResponse::studentUserId).toList());

        List<ApplicationResponse> hydrated = responses.stream()
                .map(response -> response.withStudent(students.get(response.studentUserId())))
                .toList();

        return PageResponse.of(hydrated, page.getNumber(), page.getSize(), page.getTotalElements());
    }

    @Override
    @Transactional
    public ApplicationResponse updateStatus(Long applicationId, UpdateApplicationStatusRequest request) {
        Application application = applicationRepository.findDetailedById(applicationId)
                .orElseThrow(() -> new ResourceNotFoundException("Application", "id", applicationId));

        ApplicationStatus target = ApplicationStatus.valueOf(request.status());
        AuthenticatedUser user = SecurityContextUtil.requireUser();

        // A student may only withdraw; everything else belongs to the job owner.
        if (target == ApplicationStatus.WITHDRAWN) {
            if (!user.isOwner(application.getStudentUserId()) && !user.isPlatformAdmin()) {
                throw new ForbiddenException(ErrorCode.NOT_RESOURCE_OWNER);
            }
        } else {
            assertCanManageJob(application.getJob());
        }

        ApplicationStatus current = application.getStatus();
        if (!current.canTransitionTo(target)) {
            throw new ConflictException(ErrorCode.INVALID_STATUS_TRANSITION,
                    "Cannot move an application from %s to %s".formatted(current, target));
        }

        application.setStatus(target);
        application.setStatusChangedAt(Instant.now());
        application.setStatusChangedBy(user.userId());
        Application saved = applicationRepository.save(application);

        eventPublisher.publishApplicationStatusChanged(saved, current.name());
        log.info("Application {} moved {} -> {}", applicationId, current, target);

        return mapper.toResponse(saved);
    }

    @Override
    @Transactional
    public ReferralResponse grantReferral(GrantReferralRequest request) {
        AuthenticatedUser user = SecurityContextUtil.requireUser();

        Application application = applicationRepository.findDetailedById(request.applicationId())
                .orElseThrow(() -> new ResourceNotFoundException("Application", "id",
                        request.applicationId()));

        Job job = application.getJob();
        assertCanManageJob(job);

        if (referralRepository.existsByApplicationId(application.getId())) {
            throw new ConflictException(ErrorCode.VALIDATION_FAILED,
                    "A referral has already been granted for this application");
        }
        if (!job.hasReferralSlot()) {
            throw new ConflictException(ErrorCode.REFERRAL_SLOTS_EXHAUSTED);
        }

        Referral referral = Referral.builder()
                .application(application)
                .alumniUserId(user.userId())
                .studentUserId(application.getStudentUserId())
                .referralCode(request.referralCode())
                .note(request.note())
                .grantedAt(Instant.now())
                .build();
        Referral saved = referralRepository.save(referral);

        job.setReferralSlotsUsed(job.getReferralSlotsUsed() + 1);
        jobRepository.save(job);

        if (application.getStatus().canTransitionTo(ApplicationStatus.REFERRED)) {
            ApplicationStatus previous = application.getStatus();
            application.setStatus(ApplicationStatus.REFERRED);
            application.setStatusChangedAt(Instant.now());
            application.setStatusChangedBy(user.userId());
            applicationRepository.save(application);
            eventPublisher.publishApplicationStatusChanged(application, previous.name());
        }

        log.info("Alumni {} referred student {} for job {}",
                user.userId(), application.getStudentUserId(), job.getId());
        return mapper.toResponse(saved);
    }

    @Override
    @Transactional(readOnly = true)
    public PageResponse<ReferralResponse> myReferrals(Pageable pageable) {
        AuthenticatedUser user = SecurityContextUtil.requireUser();

        Page<Referral> page = user.hasRole(Role.ROLE_ALUMNI)
                ? referralRepository.findByAlumniUserIdOrderByGrantedAtDesc(user.userId(), pageable)
                : referralRepository.findByStudentUserIdOrderByGrantedAtDesc(user.userId(), pageable);

        return PageResponse.of(page.getContent().stream().map(mapper::toResponse).toList(),
                page.getNumber(), page.getSize(), page.getTotalElements());
    }

    // ---------- guards ----------

    private void assertCanView(Application application) {
        AuthenticatedUser user = SecurityContextUtil.requireUser();
        if (user.isStaff()) {
            return;
        }
        if (user.isOwner(application.getStudentUserId())) {
            return;
        }
        if (application.getJob() != null && user.isOwner(application.getJob().getPostedByUserId())) {
            return;
        }
        throw new ForbiddenException(ErrorCode.NOT_RESOURCE_OWNER);
    }

    private void assertCanManageJob(Job job) {
        AuthenticatedUser user = SecurityContextUtil.requireUser();
        if (user.isStaff()) {
            return;
        }
        if (job != null && user.isOwner(job.getPostedByUserId())) {
            return;
        }
        throw new ForbiddenException(ErrorCode.NOT_RESOURCE_OWNER,
                "Only the person who posted this job can manage its applications");
    }
}
