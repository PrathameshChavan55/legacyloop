# Copy to .env before running docker compose. Every value has a working default, so the file is
# only needed when you want to change something.

# --- database
DB_PASSWORD=root

# --- security
# At least 32 characters. Change this for anything other than a local demo: all three services
# verify tokens with it, and anyone holding it can mint a valid token.
JWT_SECRET=change-me-in-production-legacyloop-lite-secret-key

# --- where the browser reaches the app, used in the links inside emails
APP_URL=http://localhost:3000

# --- email. Set to true to send real emails via SMTP (e.g. Gmail).
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# --- payments. Blank runs checkout in stub mode: the flow completes without contacting Razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- AI. Gemini API key for AI resume analysis, interview prep, and career tools.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- seed the demo institution, accounts, jobs and plans on first start
SEED_DEMO_DATA=true
